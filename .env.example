# Cloud LLM for the agent (phases 2-3). OpenAI-compatible base URL + model.
# Defaults below work with LLM7.io anonymously (no signup): 30 RPM.
# Register at https://dash.llm7.io for a token and 120 RPM.
LLM_BASE_URL=https://api.llm7.io/v1
LLM_API_KEY=unused
LLM_MODEL=DeepSeek-V4-Flash-0731
#
# Other OpenAI-compatible providers:
# DeepSeek:  LLM_BASE_URL=https://api.deepseek.com/v1            LLM_MODEL=deepseek-chat
# Gemini:    LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   LLM_MODEL=gemini-2.0-flash